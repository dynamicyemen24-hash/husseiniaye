  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:marketing": "cross-env BUILD_TARGET=marketing vite",
    "dev:app": "cross-env BUILD_TARGET=app vite",
    "prebuild": "node scripts/enforce-design-system.mjs",
    "build": "pnpm run build:marketing && pnpm run build:app && node scripts/build-server.cjs",
    "build:marketing": "cross-env BUILD_TARGET=marketing vite build",
    "build:app": "cross-env BUILD_TARGET=app vite build",
    "start": "cross-env NODE_ENV=production node api/index.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:full": "cross-env COVERAGE_SCOPE=full vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:mutation": "stryker run",
    "readiness": "node scripts/prod-readiness.mjs",
    "readiness:strict": "node scripts/prod-readiness.mjs --strict",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:migrate:ci": "tsx scripts/migrate.ts up",
    "db:seed:prod": "tsx scripts/seed-production.ts",
    "db:status": "tsx scripts/migrate.ts status",
    "db:generate": "tsx scripts/migrate.ts generate",
    "db:check": "tsx scripts/migrate.ts check",
    "fonts:download": "node scripts/download-fonts.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "postbuild": "tsx scripts/run-migrations.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:e2e": "node --env-file=.env scripts/seed-e2e-user.mjs",
    "loadtest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-load-test.ps1",
    "loadtest:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-load-test.ps1 smoke",
    "loadtest:load": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-load-test.ps1 load",
    "loadtest:prepare": "node scripts/dl-k6.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  },
